# Copy to .env and change the passwords. .env is ignored by Git.
# These are fake values for a local database only.

# PostgreSQL container (docker-compose.yml, services db and db-e2e)
POSTGRES_DB=matriz
POSTGRES_USER=matriz
POSTGRES_PASSWORD=change-me

# Backend connection (backend/src/main/resources/application.yml).
# DB_USERNAME and DB_PASSWORD are also used by the backend container (docker-compose.yml),
# which connects to the "db" service instead of DB_URL.
DB_URL=jdbc:postgresql://localhost:5432/matriz
DB_USERNAME=matriz
DB_PASSWORD=change-me
